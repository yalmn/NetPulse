# === NetPulse Konfiguration ===

# Projektname (wird in Docker angezeigt)
COMPOSE_PROJECT_NAME=netpulse

# Öffentlicher Hostname des VPS. Ohne eigene Domain: IP mit Bindestrichen + .sslip.io
# (z. B. 203-0-113-10.sslip.io). Zum lokalen Testen: localhost
PUBLIC_HOST=

# Ports von Caddy (Standard 80/443, auf dem VPS nicht ändern)
HTTP_PORT=80
HTTPS_PORT=443

# Login (gilt für Dashboard, API und Grafana)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Origins, die die API aufrufen dürfen (GitHub Pages), kommagetrennt
ALLOWED_ORIGINS=https://yalmn.github.io

# Globalping-Token für die Länder-Checks (kostenlos auf https://dash.globalping.io)
# Ohne Token gilt das kleinere anonyme Limit.
GLOBALPING_TOKEN=
# Länder für Globalping. Das Land des VPS (VPS_COUNTRY) misst der Server selbst
# über den Blackbox Exporter und wird hier automatisch ausgelassen.
GEO_COUNTRIES=FR,JP
VPS_COUNTRY=DE

# Wie lange Prometheus Messdaten aufbewahrt
PROMETHEUS_RETENTION=30d

# Dashboard
DASHBOARD_TITLE="Monitoring Dashboard"
