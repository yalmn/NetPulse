{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "spanNulls": false, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "netpulse_geo_duration_ms{target=~\"$target\"}",
          "legendFormat": "{{country}} {{target}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(probe_duration_seconds{instance=~\"$target\"} and on(instance, job) (probe_success{instance=~\"$target\"} == 1)) * 1000",
          "legendFormat": "DE (VPS) {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Ladezeit je Land (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 10 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(netpulse_geo_success{target=~\"$target\"}[$__range]) * 100",
          "legendFormat": "{{country}} {{target}}",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(probe_success{instance=~\"$target\"}[$__range]) * 100",
          "legendFormat": "DE (VPS) {{instance}}",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "Verfügbarkeit im Zeitraum",
      "type": "stat"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["netpulse", "geo"],
  "templating": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(netpulse_geo_success, target)",
        "includeAll": true,
        "multi": true,
        "name": "target",
        "label": "Ziel",
        "query": { "query": "label_values(netpulse_geo_success, target)", "refId": "target" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Länder-Erreichbarkeit",
  "uid": "netpulse-geo",
  "version": 1
}
